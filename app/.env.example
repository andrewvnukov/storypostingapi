# TikTok for Developers -> your app -> Credentials
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Must match the Redirect URI registered in the developer portal, exactly.
# Local development: http://localhost:3000/auth/callback
TIKTOK_REDIRECT_URI=http://localhost:3000/auth/callback

# Scopes requested at login. Keep this list equal to the scopes approved for the app.
TIKTOK_SCOPES=user.info.basic,user.info.profile,user.info.stats,video.list,video.upload,video.publish

# Random string, used to sign the session cookie.
SESSION_SECRET=change-me

# Text to speech for the story studio: "openai" or "elevenlabs"
TTS_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_BASE_URL=https://api.openai.com/v1   # override for a compatible endpoint
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2

PORT=3000
