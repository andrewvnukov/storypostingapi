# /etc/systemd/system/storypostingapi.service
# Для запуска без докера: sudo systemctl enable --now storypostingapi
[Unit]
Description=StoryPostingApi
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/srv/storypostingapi/app
EnvironmentFile=/srv/storypostingapi/app/.env
Environment=NODE_ENV=production
Environment=DATA_DIR=/srv/storypostingapi/data
Environment=TRUST_PROXY=1
Environment=COOKIE_SECURE=1
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
